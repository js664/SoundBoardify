{
  "name": "simplysound-desktop",
  "version": "1.0.8",
  "description": "Open-source Windows soundboard with a phone-controlled web UI",
  "author": "SimplySound contributors",
  "license": "MIT",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test *.test.cjs",
    "build:icon": "node make-icon.cjs",
    "build:ui": "npm --prefix ../webui ci && npm --prefix ../webui run build",
    "build:backend": "node clean-backend-stage.cjs && dotnet publish ../VRSoundboard.csproj -c Release -r win-x64 --self-contained true -o ../obj/electron-backend && node write-backend-manifest.cjs",
    "build": "npm run build:icon && npm run build:ui && npm run build:backend",
    "dist": "npm run build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.simplysound.desktop",
    "productName": "SimplySound",
    "asar": true,
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "marketplace-bridge.cjs",
      "firewall-command.cjs",
      "soundboard-link.cjs",
      "version-utils.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../obj/electron-backend",
        "to": "backend",
        "filter": [
          "**/*.dll",
          "VRSoundboard.exe",
          "VRSoundboard.deps.json",
          "VRSoundboard.runtimeconfig.json",
          "backend-manifest.json",
          "Web/**/*",
          "!dist-electron/**",
          "!electron/**",
          "!webui/**",
          "!tests/**",
          "!**/bin/**",
          "!**/obj/**"
        ]
      },
      {
        "from": "SimplySound.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "firewall-setup.ps1",
        "to": "firewall-setup.ps1"
      }
    ],
    "win": {
      "icon": "SimplySound.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SimplySound-${version}-Windows.${ext}"
    },
    "nsis": {
      "artifactName": "SimplySound-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  }
}
