<Window x:Class="VRSoundboard.SoundEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Edit sound" Width="470" Height="565" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26">
    <TextBlock Text="Edit sound" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <TextBlock Text="Name"/><TextBox x:Name="NameBox" Margin="0,6,0,13"/>
    <TextBlock Text="Button label (optional)"/><TextBox x:Name="LabelBox" Margin="0,6,0,13"/>
    <TextBlock Text="Emoji (optional)"/><TextBox x:Name="IconBox" Margin="0,6,0,13"/>
    <TextBlock Text="Playback mode"/><ComboBox x:Name="ModeBox" Margin="0,6,0,13"><ComboBoxItem Content="toggle"/><ComboBoxItem Content="retrigger"/></ComboBox>
    <TextBlock Text="Output level"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.05" Margin="0,6,0,13"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Start (seconds)"/><TextBox x:Name="StartBox" Margin="0,6,0,13"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="End (seconds; blank = full)"/><TextBox x:Name="EndBox" Margin="0,6,0,13"/></StackPanel></Grid>
    <TextBlock x:Name="DurationText" Foreground="{DynamicResource Muted}" Margin="0,2,0,17"/>
    <WrapPanel HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save changes" Background="#236D60" Click="Save_Click"/></WrapPanel>
  </StackPanel>
</Window>
